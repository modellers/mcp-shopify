# Shopify API Configuration
# Get these from your Shopify Admin > Settings > Apps and sales channels > Develop apps

SHOPIFY_APP_CLIENT_ID="your_client_id_here"
SHOPIFY_APP_SECRET="shpss_your_secret_here"
SHOPIFY_APP_ENDPOINT="https://your-store.myshopify.com/admin/api/2025-10/graphql.json"

# Store Settings
STORE_COUNTRY=IS
STORE_CURRENCY=ISK
STORE_LOCALE=is-IS

# HTTP Server Configuration (for SSE transport)
HTTP_PORT=3022
HTTP_SERVER=localhost

# Debug Mode (optional)
# DEBUG=true
